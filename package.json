{
  "name": "navigo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NaviGo — 马卡龙配色个人导航页，Cloudflare Pages + D1 全栈方案",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev dist --d1=DB --port 8788 --persist-to .wrangler/state",
    "build": "vue-tsc --noEmit && vite build",
    "build:fast": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:api": "tsc -p functions/tsconfig.json",
    "preview": "vite preview",
    "cf:dev": "npm run build:fast && npm run dev:api",
    "db:init": "wrangler d1 execute navigo-db --file=./schema.sql --remote",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "pinia": "^2.2.8",
    "vue": "^3.5.13",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10",
    "wrangler": "^4.151.1"
  }
}
